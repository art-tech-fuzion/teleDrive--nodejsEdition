# ===============================================================================
# TeleDrive (Node.js + MTProto) Environment Configuration
# ===============================================================================

# Server Port
PORT=3000

# Admin Web Credentials
ADMIN_USERNAME=admin
# bcrypt hash for your admin password (e.g. '$2a$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy' for 'admin123') USE => `node -e "require('bcryptjs').hash('YourStrongPasswordHere', 10).then(console.log)"`
ADMIN_PASSWORD_HASH=

# Secure Random Session Secret (minimum 32 characters) USE=> `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`

SESSION_SECRET=your_super_secret_session_key_change_me_in_production

# Telegram MTProto Credentials (from https://my.telegram.org)
API_ID=
API_HASH=

# Telegram User String Session (Generate by running: npm run generate-session)
STRING_SESSION=

# Telegram Channels (Zero Database Architecture)
# Storage Channel ID (e.g., -1001234567890 or @your_storage_channel)
STORAGE_CHANNEL_ID=
# Index Channel ID (e.g., -1001987654321 or @your_index_channel)
INDEX_CHANNEL_ID=

# Temporary Chunks Directory
TEMP_CHUNK_DIR=temp_chunks
